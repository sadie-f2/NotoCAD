// Generated. Edit include/ncad/version.hpp.in, not the file this becomes.
//
// The patch number is the COMMAND COUNT: 0.0.53 means the registry holds 53
// commands. Sadie's convention, and it makes the version say something the
// version usually does not -- how much of R12's surface is actually there.
// tests/test_registry.cpp asserts that same number as a hard literal, so the
// two cannot drift apart without a test failing.
#pragma once

namespace ncad {

inline constexpr const char* kNcadVersion = "@NCAD_VERSION@";

// Short hash of the commit this was built from, or "unknown" outside a git
// checkout. Regenerated at BUILD time rather than configure time, so committing
// does not leave a stale hash on screen.
inline constexpr const char* kNcadGitHash = "@NCAD_GIT_HASH@";

}  // namespace ncad
